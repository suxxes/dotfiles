{{- /* Profile resolution, same on every OS: the ~/.chezmoi-profile marker,
       then the legacy /.profile root marker (kept for the existing LXC
       fleet), then a one-time prompt whose answer persists in the generated
       config. A marker that exists but is empty means default. Unattended
       init needs a marker or `--promptString profile=...`; without a TTY the
       prompt blocks, it does not fall back. Edit a marker and re-run
       `chezmoi init` for it to take effect.
       hostname and bridge are deliberately not exported as data: they would
       freeze at init time and go stale on rename. Templates read
       .chezmoi.hostname directly instead. */ -}}
{{- $profile := "" -}}
{{- $homeMarker := joinPath .chezmoi.homeDir ".chezmoi-profile" -}}
{{- if stat $homeMarker -}}
{{-   $profile = trim (output "cat" $homeMarker) | default "default" -}}
{{- else if stat "/.profile" -}}
{{-   $profile = trim (output "cat" "/.profile") | default "default" -}}
{{- else -}}
{{-   $profile = promptStringOnce . "profile" "profile" "default" -}}
{{- end -}}
{{- if not (has $profile (list "work" "personal" "default")) -}}
{{-   fail (printf "unknown profile %q; use work, personal, or default" $profile) -}}
{{- end -}}

[data]
  osType = {{ .chezmoi.os | quote }}
  profile = {{ $profile | quote }}

[onepassword]
  command = "op"
  prompt = false
