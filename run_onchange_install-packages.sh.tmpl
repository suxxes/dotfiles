#!/bin/bash
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# Runs when template hash changes
# {{ if eq .osType "darwin" }}
# Brewfile hash: # {{ include "dot_Brewfile.tmpl" | sha256sum }}
# {{ end }}
# mise config hash: # {{ include "dot_config/mise/config.toml.tmpl" | sha256sum }}

set -e

# usakura is the LXD host, not a managed dev container; skip container tooling.
# {{ if eq .chezmoi.hostname "usakura" }}
echo "==> usakura host: skipping install-packages"
exit 0
# {{ end }}

# {{ if eq .osType "darwin" }}
echo "==> macOS: Installing packages via Homebrew"

# Install Homebrew if not present
if ! command -v brew &> /dev/null; then
    echo "==> Installing Homebrew"
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    eval "$(/opt/homebrew/bin/brew shellenv)"
fi

brew bundle install --file="$HOME/.Brewfile"

# {{ else }}
echo "==> Linux: Installing packages"
sudo apt update
sudo apt install -y zsh tmux mc htop git curl unzip fontconfig fzf git-lfs postgresql-client xdg-utils xz-utils ripgrep ffmpeg age

# Ensure ~/.local/bin is in PATH (sudo clears it, chezmoi may inherit sanitized PATH)
if [ -d "$HOME/.local/bin" ]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

# chezmoi. macOS gets it from the Brewfile; on Linux it is installed once at
# bootstrap and would otherwise stay pinned to that version forever.
CHEZMOI_MIN_VERSION="2.72.0"
if ! command -v chezmoi &> /dev/null; then
    echo "==> Installing chezmoi"
    sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin"
else
    CHEZMOI_VERSION=$(chezmoi --version | sed -E 's/^chezmoi version v([0-9.]+).*/\1/')
    OLDEST=$(printf '%s\n%s\n' "$CHEZMOI_MIN_VERSION" "$CHEZMOI_VERSION" | sort -V | head -1)
    if [ "$OLDEST" != "$CHEZMOI_MIN_VERSION" ]; then
        echo "==> Upgrading chezmoi ($CHEZMOI_VERSION -> >= $CHEZMOI_MIN_VERSION)"
        chezmoi upgrade
    fi
fi

# mise
if ! command -v mise &> /dev/null; then
    curl https://mise.run | sh
    export PATH="$HOME/.local/bin:$PATH"
fi

# tailscale
if ! command -v tailscale &> /dev/null; then
    echo "==> Installing Tailscale"
    curl -fsSL https://tailscale.com/install.sh | sh
fi
# {{ end }}

# Runtimes and cross-platform CLIs: everything listed in ~/.config/mise/config.toml.
echo "==> Installing mise tools"
mise install --yes

# Note: Claude credentials sync is handled by bind mount in cloud-init
# See cloud-init.vendor-data in LXD profile for automatic setup

# Tailscale auth: handled by run_after_tailscale-auth.sh.tmpl (runs every apply)

# Install Session Manager plugin (macOS handled via Brewfile)
# {{ if ne .osType "darwin" }}
if ! command -v session-manager-plugin &> /dev/null; then
    echo "==> Installing Session Manager plugin"
    SSM_ARCH=""
    case "$(uname -m)" in
        x86_64) SSM_ARCH="ubuntu_64bit" ;;
        aarch64|arm64) SSM_ARCH="ubuntu_arm64" ;;
        *) echo "WARNING: Unsupported architecture for Session Manager plugin: $(uname -m)" ;;
    esac
    if [ -n "$SSM_ARCH" ]; then
        curl -fsSL "https://s3.amazonaws.com/session-manager-downloads/plugin/latest/${SSM_ARCH}/session-manager-plugin.deb" -o /tmp/session-manager-plugin.deb
        sudo dpkg -i /tmp/session-manager-plugin.deb
        rm /tmp/session-manager-plugin.deb
    fi
fi
# {{ end }}
