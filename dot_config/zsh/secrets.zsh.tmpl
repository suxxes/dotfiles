# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# Generated exports stay outside the source state.
# {{ if ne .osType "darwin" -}}
if [[ -f "$HOME/.config/op/service-account-token" ]]; then
    () {
        setopt localoptions extendedglob
        local op_service_token="$(<"$HOME/.config/op/service-account-token")"
        export OP_SERVICE_ACCOUNT_TOKEN="${${op_service_token##[[:space:]]#}%%[[:space:]]#}"
    } || return $?
fi
# {{ end -}}
if [[ -f "$HOME/.config/secrets/env.zsh" ]]; then
    source "$HOME/.config/secrets/env.zsh" || return $?
fi
export HOMEBREW_GITHUB_API_TOKEN="${GITHUB_TOKEN-}"
