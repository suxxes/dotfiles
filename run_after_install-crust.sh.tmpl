#!/bin/bash
# chezmoi:template:left-delimiter="# {{" right-delimiter="}}"
# Keeps crust at its latest release through mise on every apply. The release
# repository is private, so mise reads GITHUB_TOKEN to reach it.

set -e

# usakura is the LXD host, not a managed dev container; skip container tooling.
# {{ if eq .chezmoi.hostname "usakura" }}
echo "==> usakura host: skipping crust"
exit 0
# {{ end }}

if [ -z "${GITHUB_TOKEN:-}" ]; then
    echo "==> crust: GITHUB_TOKEN is not set; cannot reach the private release. Skipping."
    exit 0
fi

# mise owns the binary; put its shims on PATH for a fresh host whose shell never activated mise.
eval "$(mise activate bash --shims)"

# upgrade also installs crust when it is missing. A running session keeps its old binary.
mise upgrade --yes github:suxxes/crust
